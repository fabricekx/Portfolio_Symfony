{% extends 'base.html.twig' %}

{% block title %}Welcome to my Portfolio !
{% endblock %}

{% block body %}
	<!-- Partie PORTFOLIO -->
	<div class="row container-fluid ">
    <div class="mt-5"></div>
		<div class="col-12 mt-5 d-flex justify-content-center align-items-center">
			<div id="carouselExampleIndicators" class="carousel slide mx-auto" data-bs-ride="carousel" style="max-width: 800px;">

				<div
					class="carousel-inner text-center">
					{# Boucle dynamique sauf pour Squid Game en attente #}
					{% for projet in projets %}
						<div class="carousel-item  {% if loop.first %}active{% endif %}">
							<h3 class="">{{ projet.title }}</h3>
							<img class="d-block img-fluid mx-auto" src="{{ asset('uploads/images/' ~ projet.image) }}" alt="{{ projet.title }}" style="max-height: 400px; object-fit: cover;">
							<div class="carousel-caption d-md-block text-white">
								<a class="btn-portfolio" href="{{ projet.link }}" target="_blank" rel="noreferrer noopener">VOIR</a>
							</div>
						</div>
					{% endfor %}

					{# Partie temporaire pour Squid Game #}
					<div class="carousel-item ">
						<h3 class=" ">Jeu Squid Game</h3>
						<img class="d-block img-fluid mx-auto" src="{{ asset('uploads/images/squid.jpg') }}" alt="Squid Game" style="max-height: 400px; object-fit: cover;">
						<div class="carousel-caption d-md-block">
							<a class="btn-portfolio" href="{{ path('app_construction') }}" rel="noreferrer noopener">VOIR</a>
						</div>
					</div>
				</div>

				<a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-bs-slide="prev">
					<span class="carousel-control-prev-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Previous</span>
				</a>
				<a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-bs-slide="next">
					<span class="carousel-control-next-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Next</span>
				</a>
			</div>
		</div>
	</div>

{% endblock %}
